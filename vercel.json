{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run vercel-build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin/sign-in",
      "destination": "https://admin.playbackfire.com/login",
      "permanent": true
    },
    {
      "source": "/admin/login",
      "destination": "https://admin.playbackfire.com/login",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "https://admin.playbackfire.com",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.playbackfire.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
